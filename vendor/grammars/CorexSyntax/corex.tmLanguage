{
  name = "Nexar";
  scopeName = "source.nexar";
  fileTypes = ( nexar );

  patterns = (
    { include = "#comments"; },
    { include = "#keywords"; },
    { include = "#types"; },
    { include = "#strings"; },
    { include = "#numbers"; },
    { include = "#functions"; },
    { include = "#operators"; }
  );

  repository = {

    comments = {
      patterns = (
        {
          name = "comment.line.double-slash.nexar";
          match = "//.*$";
        }
      );
    };

    keywords = {
      patterns = (
        {
          name = "keyword.control.nexar";
          match = "\\b(function|var|const|if|else|loop|return|module|use)\\b";
        }
      );
    };

    types = {
      patterns = (
        {
          name = "storage.type.nexar";
          match = "\\b(Int|Float|String|Bool|Void|Array|Object)\\b";
        }
      );
    };

    numbers = {
      patterns = (
        {
          name = "constant.numeric.nexar";
          match = "\\b\\d+(\\.\\d+)?\\b";
        }
      );
    };

    strings = {
      patterns = (
        {
          name = "string.quoted.double.nexar";
          begin = "\"";
          end = "\"";
        }
      );
    };

    functions = {
      patterns = (
        {
          name = "entity.name.function.nexar";
          match = "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\()";
        }
      );
    };

    operators = {
      patterns = (
        {
          name = "keyword.operator.nexar";
          match = "[+\\-*/%=<>!&|]+";
        }
      );
    };

  };
}
