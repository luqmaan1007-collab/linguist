// Advanced Corex Example

import math

fn calculate(a: Float, b: Float) -> Float {
    let sum: Float = a + b
    let product: Float = a * b
    return sum / product
}

fn main() -> Int {
    let x: Float = 10.5
    let y: Float = 5.2

    if x > y {
        print("X is greater")
    } else {
        print("Y is greater")
    }

    print("Calculation: " + calculate(x, y))
    return 0
}
